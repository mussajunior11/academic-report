# ---------------------------------------------------------------------------
# Academic Report — environment configuration
# Copy this file to `.env` and adjust as needed.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# SQLite database file (Phase 1). Relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# School seed values (used by `npm run db:seed`)
SEED_SCHOOL_NAME="Academic Report Secondary School"
SEED_SCHOOL_CODE="ARS"
SEED_ACADEMIC_YEAR="2026"

# Set to "true" to also seed a handful of sample students (development only).
SEED_DEV_DATA="false"

# Secret used to sign session cookies. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Default administrator created by the seed (used by `npm run db:seed`).
SEED_ADMIN_EMAIL="admin@academic-report.local"
SEED_ADMIN_PASSWORD="Admin@12345"
